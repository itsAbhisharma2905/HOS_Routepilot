# Backend
DJANGO_SECRET_KEY=replace-me-for-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# OpenStreetMap-compatible providers
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=HOSRoutePilot/0.1 (replace-with-your-contact)
NOMINATIM_MIN_INTERVAL_SECONDS=1
OSRM_BASE_URL=http://router.project-osrm.org
EXTERNAL_PROVIDER_TIMEOUT_SECONDS=10
PLANNING_START_TIMESTAMP=2026-01-01T08:00:00+00:00
